# Local UTF-8 data only: never source this file. Copy to .env and edit yourself.
# No editor is launched. KEY=value, single/double quotes, spaces and comments
# are supported. Duplicate keys fail. No shell expansion or command execution.
# Only selected environments are required: --environments dev (default),
# dev,stage,prod, or a subset. GitHub stage maps to Azure environment "test".
#
# Configure this local file, then run either wrapper with no arguments.
# Default .env is resolved beside the repository scripts, even from another cwd.
# Explicit --env-file relative paths are resolved from the caller's directory.
# CLI flags override the corresponding local keys. No remote .env is ever read.
# Start with --dry-run (read-only checks still require GitHub authentication).
# Explicit flags remain available:
# bash 01a-GH-mirror-repo-from-template-once.sh --source azure/enterprise-scale-aifactory \
#   --source-branch release/v1.25 --destination OWNER/REPO --visibility private \
#   --destination-state create --default-branch release/v1.25 --transport https \
#   --environments dev --auth-mode oidc --env-file .env --dry-run
# Use --destination-state existing-empty only for a verified empty destination.
# Remove --dry-run to apply. Initial mirror requires every selected auth secret.
# Subsequent config-only sync NEVER clones, pushes, deletes or changes branches:
# bash 02b-GH-create-or-update-github-variables.sh --destination OWNER/REPO \
#   --environments dev --auth-mode oidc --env-file .env --dry-run
# Legacy aliases: GITHUB_TEMPLATE_REPO -> GITHUB_SOURCE_REPO,
# GITHUB_NEW_REPO -> GITHUB_DESTINATION_REPO,
# GITHUB_NEW_REPO_VISIBILITY -> GITHUB_VISIBILITY,
# GITHUB_USE_SSH=true|false -> GITHUB_TRANSPORT=ssh|https.
# Conflicting aliases fail closed unless overridden explicitly on the CLI.

# Required explicit repository policy. Destination-state is intentionally unset:
# choose create for a NEW repository, or existing-empty for an existing empty one.
# A generic 404 never proves absence. No overwrite/force-existing mode exists.
GITHUB_SOURCE_REPO="azure/enterprise-scale-aifactory"
GITHUB_SOURCE_BRANCH="release/v1.25"
GITHUB_DESTINATION_REPO="<owner>/<new-repository>"
GITHUB_VISIBILITY="private" # private, public, internal
GITHUB_DESTINATION_STATE="<create-or-existing-empty>"
GITHUB_DEFAULT_BRANCH="release/v1.25" # destination only; must match source branch
GITHUB_TRANSPORT="https" # https or ssh; authenticate the selected Git transport
GITHUB_ENVIRONMENTS="dev" # dev,stage,prod or selected subset
GITHUB_AUTH_MODE="oidc" # oidc or credentials

# Required common values. Nonzero UUIDs are validated for tenant/subscription/identity.
TENANT_ID="<todo_tenant_uuid>"
AIFACTORY_LOCATION="swedencentral"
AIFACTORY_LOCATION_SHORT="sdc"
AIFACTORY_PREFIX="<todo>"
AIFACTORY_SUFFIX="-001"
LAKE_PREFIX="<todo>"
AIFACTORY_SEEDING_KEYVAULT_SUBSCRIPTION_ID="<todo_subscription_uuid>"
AIFACTORY_SEEDING_KEYVAULT_NAME="<todo>"
AIFACTORY_SEEDING_KEYVAULT_RG="<todo>"
PROJECT_NUMBER="001"

# Required only for selected environments. AZURE_SUBSCRIPTION_ID is a GitHub
# variable (not a secret), matching pinned PURPLE workflow references.
DEV_SUBSCRIPTION_ID="<todo_subscription_uuid>"
STAGE_SUBSCRIPTION_ID="<todo_subscription_uuid>"
PROD_SUBSCRIPTION_ID="<todo_subscription_uuid>"
DEV_CIDR_RANGE="20"
STAGE_CIDR_RANGE="30"
PROD_CIDR_RANGE="40"

# Preferred: --auth-mode oidc (default). Configure federation in Azure separately.
# {ENV}_AZURE_CLIENT_ID maps to secrets.AZURE_CLIENT_ID; TENANT_ID maps to a
# secret. DEV_TENANT_ID/STAGE_TENANT_ID/PROD_TENANT_ID may override TENANT_ID.
# Federated subject: repo:OWNER/REPO:environment:dev (or stage/prod).
DEV_AZURE_CLIENT_ID="<todo_client_uuid>"
STAGE_AZURE_CLIENT_ID="<todo_client_uuid>"
PROD_AZURE_CLIENT_ID="<todo_client_uuid>"

# Explicit fallback: --auth-mode credentials, real JSON only; never dummy values.
# Single quotes preserve JSON, spaces and shell metacharacters literally:
# DEV_AZURE_CREDENTIALS='{"clientId":"UUID","clientSecret":"REAL SECRET","tenantId":"UUID","subscriptionId":"UUID"}'
# Blank/omitted secrets preserve existing secrets during sync; required missing
# secrets must already exist remotely. No secret is ever cleared or deleted.
DEV_AZURE_CREDENTIALS=""
STAGE_AZURE_CREDENTIALS=""
PROD_AZURE_CREDENTIALS=""

# Optional settings have NO bootstrap defaults. Blank/omitted/placeholder optional
# values preserve GitHub state. Feature and persona choices belong in the consumer
# JSON configuration. This mapping catalogs every pinned workflow reference:
# bootstrap/github-settings.json. Optional names accept ENV_NAME before NAME.
# These legacy aliases remain supported when explicitly populated:
TENANT_AZUREML_OID=""
PROJECT_TYPE="" # alias for ADMIN_PROJECT_TYPE
PROJECT_MEMBERS=""
PROJECT_MEMBERS_EMAILS=""
PROJECT_MEMBERS_IP_ADDRESS=""
PROJECT_SERVICE_PRINCIPAL_KV_S_NAME_APPID=""
PROJECT_SERVICE_PRINCIPAL_KV_S_NAME_OID=""
PROJECT_SERVICE_PRINCIPAL_KV_S_NAME_S=""
COMMON_SERVICE_PRINCIPAL_KV_S_NAME_APPID=""
COMMON_SERVICE_PRINCIPAL_KV_S_NAME_SECRET=""
AIFACTORY_SALT="" # post-deployment value only, never invented

# Optional networking aliases. Blank values preserve existing GitHub settings.
DEV_BYO_VNET_NAME=""
DEV_BYO_VNET_RG=""
STAGE_BYO_VNET_NAME=""
STAGE_BYO_VNET_RG=""
