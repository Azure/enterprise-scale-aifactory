# Local UTF-8 data only: copy to .env and edit; never source this file.
# KEY=value, single/double quotes, spaces and comments are supported.
# Duplicate/unsupported keys fail. No expansion, execution or editor launch.
#
# v1.25+ REGISTERED consumers only (azurefactory/register.json).
# This file configures GitHub REMOTE environment variables/secrets, not factory
# settings. It never writes the register/catalog, creates pipeline bindings,
# installs workflows, enrolls identities, configures federation, authenticates
# the local API, or propagates values into API/runtime configuration.
# Configure factory settings through the registered CLI/API separately.
#
# Both wrappers accept no arguments after this file is configured:
# bash 01a-GH-mirror-repo-from-template-once.sh --dry-run
# bash 02b-GH-create-or-update-github-variables.sh --dry-run
# Remove --dry-run to apply. Dry-run still needs authenticated gh and, for mirror,
# authenticated Git transport. gh must have the required repository permissions.
# Mirror copies ALL refs/history, including historical branches; only the selected
# v1.25+ release becomes the destination default. Neither main nor older releases
# can be selected. Review historical contents before authorizing a full mirror.
# Sync only changes GitHub environments/settings: never Git refs, history or files.
# Default .env is beside the repository scripts, even from another cwd.
# --env-file uses caller-relative paths; CLI policy flags override local keys.
#
# Repository policy: use create for NEW, existing-empty for verified empty.
# Generic 404 never proves absence. There is no overwrite/force-existing mode.
GITHUB_SOURCE_REPO="azure/enterprise-scale-aifactory"
GITHUB_SOURCE_BRANCH="release/v1.25"
GITHUB_DESTINATION_REPO="<owner>/<new-repository>"
GITHUB_VISIBILITY="private" # private, public, internal; single-writer requires private
GITHUB_DESTINATION_STATE="<create-or-existing-empty>"
# GITHUB_DEFAULT_BRANCH may be omitted: defaults to the selected source release.
# If supplied, it MUST equal GITHUB_SOURCE_BRANCH; no branch is rewritten.
GITHUB_TRANSPORT="https" # https or ssh
GITHUB_ENVIRONMENTS="dev" # distinct subset of dev,stage,prod
GITHUB_AUTH_MODE="<oidc-or-oidc-single-writer>" # mandatory explicit choice, no default

# Choose the contract matching the separately reviewed provider workflow:
# oidc: pinned bootstrap/templates/factory-lifecycle-gha.yml uses
#   secrets.AZURE_CLIENT_ID, secrets.TENANT_ID, vars.AZURE_SUBSCRIPTION_ID.
# oidc-single-writer: pinned factory-lifecycle-single-writer-gha.yml uses
#   vars.AZURE_CLIENT_ID, vars.AZURE_TENANT_ID, vars.AZURE_SUBSCRIPTION_ID.
# The latter publishes these UUIDs as public variables, NOT secret values.
# Neither choice selects/changes coordination mode or creates an enrollment.
# Both templates support OIDC, NOT AZURE_CREDENTIALS JSON. There is no compatible
# credential fallback at this pin: such keys/modes are rejected, never uploaded.
# Existing secrets (including old credentials) are never deleted or cleared.
#
# Evidence is pinned PURPLE 89eca66185366a702b026cec8c938570548c649c:
# bootstrap/templates/factory-lifecycle[-single-writer]-gha.yml,
# bootstrap/lib/factory_lifecycle_contract.txt and factory_enrollment.py.
# API-generated Full bootstrap/project workflows are an EXTERNAL backend boundary:
# inspect their actual auth inputs, namespace and runtime pin before using this
# helper. These two source templates cannot certify an installed API's pipelines.
#
# Exact GitHub environment/auth_namespace used by the reviewed provider route.
# Defaults to the selected logical environment name if its key is omitted.
# Custom names are supported; dev/stage/prod are selectors, NOT Azure mappings.
# Values must be distinct (case-insensitive). Stage is not rewritten to "test".
DEV_GITHUB_ENVIRONMENT="dev"
STAGE_GITHUB_ENVIRONMENT="stage"
PROD_GITHUB_ENVIRONMENT="prod"
# Federation subject: repo:OWNER/REPO:environment:EXACT_AUTH_NAMESPACE.
# Configure federation/permissions separately; a successful sync proves neither.

# Only selected environments are required. Nonzero UUIDs, never placeholders.
# TENANT_ID is common; DEV_TENANT_ID/STAGE_TENANT_ID/PROD_TENANT_ID override it.
# Under oidc-single-writer TENANT_ID maps to public AZURE_TENANT_ID.
TENANT_ID="<tenant-uuid>"
DEV_SUBSCRIPTION_ID="<subscription-uuid>"
STAGE_SUBSCRIPTION_ID="<subscription-uuid>"
PROD_SUBSCRIPTION_ID="<subscription-uuid>"
DEV_AZURE_CLIENT_ID="<client-uuid>"
STAGE_AZURE_CLIENT_ID="<client-uuid>"
PROD_AZURE_CLIENT_ID="<client-uuid>"

# Initial mirror requires every selected authentication value locally.
# On sync, omitted/blank/placeholder values preserve remote state; required
# settings must already exist in that exact environment (not repository fallback).
# Public UUID variables are checked; existing secret values cannot be read/verified.
# No dummy credentials, secret deletion, feature defaults or legacy infra mappings.
# All supported remote setting names live in bootstrap/github-settings.json.
# Safety-neutral repository-policy aliases remain accepted with conflict checks:
# GITHUB_TEMPLATE_REPO, GITHUB_NEW_REPO, GITHUB_NEW_REPO_VISIBILITY, GITHUB_USE_SSH.
# No other .env keys are supported; keep CLI/API credentials outside this file.
